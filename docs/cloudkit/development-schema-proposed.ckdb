DEFINE SCHEMA

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    RECORD TYPE households (
        "___createTime"                                          TIMESTAMP,
        "___createdBy"                                           REFERENCE,
        "___etag"                                                STRING,
        "___modTime"                                             TIMESTAMP,
        "___modifiedBy"                                          REFERENCE,
        "___recordID"                                            REFERENCE,
        checkerClaimedAt                                         ENCRYPTED TIMESTAMP,
        checkerDeviceID                                          ENCRYPTED STRING,
        checkerDeviceName                                        ENCRYPTED STRING,
        createdAt                                                ENCRYPTED TIMESTAMP,
        id                                                       ENCRYPTED STRING,
        name                                                     ENCRYPTED STRING,
        sqlitedata_icloud_userModificationTime                   ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_checkerClaimedAt  ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_checkerDeviceID   ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_checkerDeviceName ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_createdAt         ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_id                ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_name              ENCRYPTED INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE listings (
        "___createTime"                                    TIMESTAMP,
        "___createdBy"                                     REFERENCE,
        "___etag"                                          STRING,
        "___modTime"                                       TIMESTAMP,
        "___modifiedBy"                                    REFERENCE,
        "___recordID"                                      REFERENCE,
        capturedBy                                         ENCRYPTED STRING,
        closesAt                                           ENCRYPTED TIMESTAMP,
        firstSeenAt                                        ENCRYPTED TIMESTAMP,
        id                                                 ENCRYPTED STRING,
        onSaleAt                                           ENCRYPTED TIMESTAMP,
        performers                                         ENCRYPTED STRING,
        room                                               ENCRYPTED STRING,
        rung                                               ENCRYPTED STRING,
        sourceID                                           ENCRYPTED STRING,
        sqlitedata_icloud_userModificationTime             ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_capturedBy  ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_closesAt    ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_firstSeenAt ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_id          ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_onSaleAt    ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_performers  ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_room        ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_rung        ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_sourceID    ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_stableKey   ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_startsAt    ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_status      ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_ticketURL   ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_title       ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_updatedAt   ENCRYPTED INT64,
        stableKey                                          ENCRYPTED STRING,
        startsAt                                           ENCRYPTED TIMESTAMP,
        status                                             ENCRYPTED STRING,
        ticketURL                                          ENCRYPTED STRING,
        title                                              ENCRYPTED STRING,
        updatedAt                                          ENCRYPTED TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE reactions (
        "___createTime"                                  TIMESTAMP,
        "___createdBy"                                   REFERENCE,
        "___etag"                                        STRING,
        "___modTime"                                     TIMESTAMP,
        "___modifiedBy"                                  REFERENCE,
        "___recordID"                                    REFERENCE,
        authorID                                         ENCRYPTED STRING,
        id                                               ENCRYPTED STRING,
        kind                                             ENCRYPTED STRING,
        listingID                                        ENCRYPTED STRING,
        note                                             ENCRYPTED STRING,
        sqlitedata_icloud_userModificationTime           ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_authorID  ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_id        ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_kind      ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_listingID ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_note      ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_updatedAt ENCRYPTED INT64,
        updatedAt                                        ENCRYPTED TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE sources (
        "___createTime"                                            TIMESTAMP,
        "___createdBy"                                             REFERENCE,
        "___etag"                                                  STRING,
        "___modTime"                                               TIMESTAMP,
        "___modifiedBy"                                            REFERENCE,
        "___recordID"                                              REFERENCE,
        adapter                                                    ENCRYPTED STRING,
        adapterVenue                                               ENCRYPTED STRING,
        area                                                       ENCRYPTED STRING,
        cadence                                                    ENCRYPTED STRING,
        consecutiveFailures                                        ENCRYPTED INT64,
        createdAt                                                  ENCRYPTED TIMESTAMP,
        excludedHosts                                              ENCRYPTED STRING,
        feedURL                                                    ENCRYPTED STRING,
        flagNote                                                   ENCRYPTED STRING,
        flaggedAt                                                  ENCRYPTED TIMESTAMP,
        householdID                                                ENCRYPTED STRING,
        id                                                         ENCRYPTED STRING,
        lastCheckNote                                              ENCRYPTED STRING,
        lastCheckOutcome                                           ENCRYPTED STRING,
        lastCheckedAt                                              ENCRYPTED TIMESTAMP,
        lastContentHash                                            ENCRYPTED STRING,
        lastListingCount                                           ENCRYPTED INT64,
        listingURL                                                 ENCRYPTED STRING,
        method                                                     ENCRYPTED STRING,
        mode                                                       ENCRYPTED STRING,
        name                                                       ENCRYPTED STRING,
        pagination                                                 ENCRYPTED STRING,
        priority                                                   ENCRYPTED STRING,
        registeredHosts                                            ENCRYPTED STRING,
        registryID                                                 ENCRYPTED STRING,
        retiredAt                                                  ENCRYPTED TIMESTAMP,
        sqlitedata_icloud_userModificationTime                     ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_adapter             ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_adapterVenue        ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_area                ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_cadence             ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_consecutiveFailures ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_createdAt           ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_excludedHosts       ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_feedURL             ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_flagNote            ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_flaggedAt           ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_householdID         ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_id                  ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_lastCheckNote       ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_lastCheckOutcome    ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_lastCheckedAt       ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_lastContentHash     ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_lastListingCount    ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_listingURL          ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_method              ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_mode                ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_name                ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_pagination          ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_priority            ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_registeredHosts     ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_registryID          ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_retiredAt           ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_startPageURL        ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_type                ENCRYPTED INT64,
        startPageURL                                               ENCRYPTED STRING,
        type                                                       ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE stays (
        "___createTime"                                      TIMESTAMP,
        "___createdBy"                                       REFERENCE,
        "___etag"                                            STRING,
        "___modTime"                                         TIMESTAMP,
        "___modifiedBy"                                      REFERENCE,
        "___recordID"                                        REFERENCE,
        arrivesOn                                            ENCRYPTED TIMESTAMP,
        departsOn                                            ENCRYPTED TIMESTAMP,
        departureKind                                        ENCRYPTED STRING,
        householdID                                          ENCRYPTED STRING,
        id                                                   ENCRYPTED STRING,
        sqlitedata_icloud_userModificationTime               ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_arrivesOn     ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_departsOn     ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_departureKind ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_householdID   ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_id            ENCRYPTED INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE tasteRecords (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE,
        id ENCRYPTED STRING,
        householdID ENCRYPTED STRING,
        sourceRegistryID ENCRYPTED STRING,
        sourceName ENCRYPTED STRING,
        stableKey ENCRYPTED STRING,
        title ENCRYPTED STRING,
        performers ENCRYPTED STRING,
        room ENCRYPTED STRING,
        startsAt ENCRYPTED TIMESTAMP,
        closesAt ENCRYPTED TIMESTAMP,
        kind ENCRYPTED STRING,
        note ENCRYPTED STRING,
        authorID ENCRYPTED STRING,
        firstDecidedAt ENCRYPTED TIMESTAMP,
        updatedAt ENCRYPTED TIMESTAMP,
        sqlitedata_icloud_userModificationTime ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_id ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_householdID ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_sourceRegistryID ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_sourceName ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_stableKey ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_title ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_performers ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_room ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_startsAt ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_closesAt ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_kind ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_note ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_authorID ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_firstDecidedAt ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_updatedAt ENCRYPTED INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );
